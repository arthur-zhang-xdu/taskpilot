APP_NAME=TaskPilot
APP_ENV=development
LOG_LEVEL=INFO
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-seed-2-0-lite-260428
LLM_TIMEOUT_SECONDS=30

# 与 compose.yaml 共用；请替换密码占位值。
POSTGRES_USER=taskpilot
POSTGRES_DB=taskpilot
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# 可选；填写后优先使用，驱动必须是 postgresql+psycopg。
DATABASE_URL=
